# PayPal Configuration
# Obtener en https://developer.paypal.com/dashboard/applications
# Sandbox para pruebas, Live para producción

# Sandbox (pruebas)
VITE_PAYPAL_CLIENT_ID=sb

# Live (producción) - Descomentar cuando esté listo
# VITE_PAYPAL_CLIENT_ID=tu-client-id-live-aqui

# Modo de PayPal: 'sandbox' o 'live'
VITE_PAYPAL_MODE=sandbox

# EmailJS Configuration
# Obtener en https://www.emailjs.com/
# Gratuito hasta 200 emails/mes
VITE_EMAILJS_SERVICE_ID=tu_service_id_aqui
VITE_EMAILJS_TEMPLATE_ID=tu_template_id_aqui
VITE_EMAILJS_PUBLIC_KEY=tu_public_key_aqui

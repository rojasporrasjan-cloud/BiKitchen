// REGLAS DE FIRESTORE — ESTE ARCHIVO ES IGUAL A LO QUE CORRE EN PRODUCCION
//
// Se sincronizo el 2 de setiembre de 2026 copiando las reglas publicadas desde
// la consola de Firebase. Antes de eso el archivo iba por su lado: tenia
// cambios de mayo y de agosto que nunca se desplegaron, y una advertencia que
// decia que desplegarlo "podria romper el checkout".
//
// Esa advertencia era FALSA, y conviene dejarlo escrito para que nadie vuelva a
// dudar: se apoyaba en que `allow update: if isAdmin()` de /pedidos/ no podia
// estar activo porque si no el cliente no podria actualizar su pedido al pagar.
// Resulta que SI esta activo, y no rompe nada: CheckoutSteps.jsx atrapa el
// `permission-denied` y crea un pedido nuevo en vez del borrador
// (src/components/CheckoutSteps.jsx, el catch de updateErr).
//
// COMO MANTENERLO ASI:
// Netlify NO despliega este archivo. Solo cambia si alguien corre
// `firebase deploy --only firestore:rules` o lo pega en la consola. Si tocas
// algo aca, desplegalo; si lo cambias en la consola, copialo aca.
//
// Hay dos mejoras propuestas que a proposito NO estan en este archivo, porque
// cada una cambia comportamiento de verdad y necesita su propia decision:
// que el cliente pueda ver sus BiPuntos (hoy no puede) y validar los pedidos
// al crearlos. Estan explicadas en REGLAS_PENDIENTES.md, en la raiz.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // FUNCIONES DE SEGURIDAD
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.email.lower() in [
          'bikitchenfood@gmail.com',
          'ginamaroli@gmail.com',
          'rojasporrasjan@gmail.com',
          'mfcorrales15@gmail.com'
        ];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailOwner(email) {
      return isAuthenticated() && request.auth.token.email.lower() == email.lower();
    }

    // ==========================================
    // COLECCIONES PÚBLICAS (Solo lectura pública)
    // ==========================================

    match /menus_oficial/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipping_zones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promociones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promociones_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /individuales_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packs_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /temporada_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // NOTIFICACIONES Y SUSCRIPCIONES
    // ==========================================

    match /push_subscriptions/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if true;
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
      allow delete: if isAdmin();
    }

    // ==========================================
    // PEDIDOS (Propietario o Admin)
    // ==========================================

    match /pedidos/{pedidoId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isAuthenticated() && resource.data.correo.lower() == request.auth.token.email.lower());
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // USUARIOS (Propietario o Admin)
    // ==========================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // ==========================================
    // PUNTOS DE FIDELIDAD
    // ==========================================

    match /loyalty/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /loyalty_points/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // RESEÑAS
    // ==========================================

    match /reviews/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpful']));
      allow delete: if isAdmin();
    }

    // ==========================================
    // GESTIÓN INTERNA (Solo Admin)
    // ==========================================

    match /inventario/{doc} { allow read, write: if isAdmin(); }
    match /clientes/{doc} { allow read, write: if isAdmin(); }
    match /stats/{doc} { allow read, write: if isAdmin(); }
    match /admin_config/{doc} { allow read, write: if isAdmin(); }


    // ==========================================
    // HOJA DE COCINA
    // ==========================================

    // Las correcciones que Gina hace a mano sobre la hoja: cuanto cocinar de
    // cada cosa y la nota de empaque. Un documento por fecha de produccion.
    match /ajustes_cocina/{fecha} { allow read, write: if isAdmin(); }

    // Que pedidos ya se le mandaron a la cocina. La hoja va por tandas —el
    // jueves los mensuales y quincenales, despues lo que fue entrando— y cada
    // una lleva solo lo que no se mando antes. Sin este registro la del viernes
    // repetiria la del jueves y se cocinaria dos veces.
    match /tandas_cocina/{id} { allow read, write: if isAdmin(); }

    // ==========================================
    // REGLA POR DEFECTO - DENEGAR TODO
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

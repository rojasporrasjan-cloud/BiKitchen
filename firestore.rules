rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES DE SEGURIDAD
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email in [
          'bikitchenfood@gmail.com',
          'ginamaroli@gmail.com',
          'rojasporrasjan@gmail.com'
        ];
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ==========================================
    // COLECCIONES PÚBLICAS (Solo lectura pública)
    // ==========================================
    
    match /menus/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /menus_oficial/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /menus_oficiales/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /packs/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /packs_imagenes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /individuales_imagenes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /temporada_imagenes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /promociones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /promociones_imagenes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /productos/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /categorias/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // IMÁGENES - Para el gestor de imágenes
    // ==========================================
    
    match /imagenes/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /menu_items/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // CUPONES - SEGURIDAD REFORZADA
    // ==========================================
    
    match /coupons/{couponId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy', 'lastUsed']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1
      );
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // INVENTARIO
    // ==========================================
    
    match /inventory/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /inventario/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // CLIENTES - SOLO ADMIN
    // ==========================================
    
    match /clientes/{doc} {
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // PEDIDOS - Permite checkout sin cuenta
    // ==========================================
    
    match /pedidos/{pedidoId} {
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isAuthenticated() && resource.data.correo == request.auth.token.email);
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    match /orders/{orderId} {
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isAuthenticated() && resource.data.correo == request.auth.token.email);
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    
    // ==========================================
    // USUARIOS - SEGURIDAD CRÍTICA
    // ==========================================
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && 
        request.resource.data.role != 'admin';
      allow update: if (isOwner(userId) && 
        request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // PUNTOS DE FIDELIDAD
    // ==========================================
    
    match /loyalty/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /loyalty_points/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /points_history/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // ==========================================
    // NOTIFICACIONES
    // ==========================================
    
    match /push_subscriptions/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /notifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // ==========================================
    // SOLO ADMIN
    // ==========================================
    
    match /stats/{doc} {
      allow read, write: if isAdmin();
    }
    
    match /activity_logs/{doc} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    match /admin_config/{doc} {
      allow read, write: if isAdmin();
    }
    
    // ==========================================
    // REGLA POR DEFECTO - DENEGAR TODO
    // ==========================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

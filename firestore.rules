rules_version = '2';

// ⚠️ ATENCIÓN ANTES DE DESPLEGAR ESTE ARCHIVO
//
// Netlify NO despliega estas reglas: solo cambian si alguien corre
// `firebase deploy --only firestore:rules` o las pega en la consola de Firebase.
//
// Hay evidencia fuerte de que este archivo NO refleja las reglas que están
// corriendo en producción. Si `allow update: if isAdmin()` de /pedidos/ estuviera
// activo, el navegador del cliente no podría actualizar su propio pedido después
// de pagar, y CheckoutSteps.jsx terminaría mostrando el alert de
// "Contáctanos en WhatsApp para confirmar tu pedido" a TODOS los que pagan con
// tarjeta. Eso no está pasando.
//
// Conclusión: desplegar este archivo tal cual podría romper el checkout.
// Antes de hacerlo, comparalo contra la consola de Firebase y actualizá acá lo
// que esté distinto.

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // FUNCIONES DE SEGURIDAD
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email.lower() in [
          'bikitchenfood@gmail.com',
          'ginamaroli@gmail.com',
          'rojasporrasjan@gmail.com',
          'mfcorrales15@gmail.com'
        ];
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailOwner(email) {
      return isAuthenticated() && request.auth.token.email.lower() == email.lower();
    }
    
    // ==========================================
    // COLECCIONES PÚBLICAS (Solo lectura pública)
    // ==========================================
    
    match /menus_oficial/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /shipping_zones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /promociones/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /promociones_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /individuales_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /packs_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /temporada_imagenes/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ==========================================
    // NOTIFICACIONES Y SUSCRIPCIONES
    // ==========================================

    match /push_subscriptions/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if true; // Permitir que cualquiera se suscriba
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin() || isOwner(userId);
    }

    match /notifications/{notifId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true; // Permitir que se generen alertas (ej: al hacer pedido)
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']));
      allow delete: if isAdmin();
    }

    // ==========================================
    // PEDIDOS (Propietario o Admin)
    // ==========================================
    
    match /pedidos/{pedidoId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid) ||
        (isAuthenticated() && resource.data.correo.lower() == request.auth.token.email.lower());
      // FIX 5: Validar campos mínimos en creación de pedidos
      // El bypass de isAdmin() permite pedidos creados desde el panel (importador de
      // WhatsApp, pedidos manuales) sin relajar la validación para el público.
      // No amplía privilegios: un admin ya tiene `allow update, delete` acá abajo.
      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll(['cliente', 'correo', 'telefono', 'items', 'total'])
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.correo is string
        && request.resource.data.correo.size() > 4
      );
      allow update, delete: if isAdmin();
    }

    // Colección legacy: ya nadie escribe acá (todo el sistema usa /pedidos/).
    // Se mantiene para poder leer el historial viejo.
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      // FIX 5: Validar campos mínimos en creación de órdenes
      allow create: if isAdmin() || (
        request.resource.data.keys().hasAll(['cliente', 'correo', 'telefono', 'items', 'total'])
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.correo is string
        && request.resource.data.correo.size() > 4
      );
      allow update, delete: if isAdmin();
    }
    
    // ==========================================
    // USUARIOS (Propietario o Admin)
    // ==========================================
    
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role != 'admin';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // ==========================================
    // PUNTOS DE FIDELIDAD
    // ==========================================

    match /loyalty/{userId} {
      allow read, write: if isEmailOwner(userId) || isAdmin();
    }
    
    match /loyalty_points/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // ==========================================
    // RESEÑAS
    // ==========================================
    
    match /reviews/{id} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdmin() || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpful']));
      allow delete: if isAdmin();
    }

    // ==========================================
    // GESTIÓN INTERNA (Solo Admin)
    // ==========================================
    
    match /inventario/{doc} { allow read, write: if isAdmin(); }
    match /clientes/{doc} { allow read, write: if isAdmin(); }
    match /stats/{doc} { allow read, write: if isAdmin(); }
    match /admin_config/{doc} { allow read, write: if isAdmin(); }

    // Las correcciones que Gina hace a mano sobre la hoja de cocina: cuanto
    // cocinar de cada cosa y la nota de empaque. Un documento por fecha de
    // produccion. Sin esta regla la hoja se ve pero no deja guardar nada
    // —"permission-denied"— y el cambio se pierde al recargar.
    match /ajustes_cocina/{fecha} { allow read, write: if isAdmin(); }
    
    // ==========================================
    // REGLA POR DEFECTO - DENEGAR TODO
    // ==========================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
